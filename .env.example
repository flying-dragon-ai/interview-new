# ============================================================
# LGD 群面模拟器 v0.7-tow 环境变量（复制为 .env.local 填入真实值）
# 注意：所有 key 仅存服务端（Vercel 项目环境变量 / 本地 .env.local），
# 前端 bundle 不持有任何 key（C9 / D1）。
# ============================================================

# DeepSeek（LLM 代理 /api/llm 使用；已泄露的旧 key 必须轮换）
DEEPSEEK_API_KEY=

# 可选：替换为任意 OpenAI 兼容端点与模型（如 Kimi/Moonshot）
# DEEPSEEK_BASE_URL=https://api.moonshot.cn/v1
# DEEPSEEK_MODEL=kimi-k3
# DEEPSEEK_TEMPERATURE=1   # Kimi k2/k3 仅允许 1
# DEEPSEEK_MAX_TOKENS=32768 # 推理模型思考链预算（kimi 系建议 ≥32768）
# DEEPSEEK_REASONING=low      # 推理强度：Kimi 系强烈建议 low（默认思考链 4min+ 且无可见输出）
# StepFun（TTS / ASR 凭证签发；未配置时前端自动降级 Web Speech / 文字）
STEPFUN_API_KEY=

# 阿里云 RDS PostgreSQL 连接串（DATABASE_URL；旧明文凭据必须轮换）
# 格式：postgresql://<user>:<password>@<host>:5432/interview_db?sslmode=require
DATABASE_URL=

# 可选：GitHub Pages 部署时的 base 路径（默认 /）
VITE_BASE_PATH=

# ============================================================
# Para 钱包（Monad Testnet 身份层，Q-N1）—— 公开 key，可上前端
# 获取：npm i -g @getpara/cli && para login && para keys create（见 docs/monad-wallet.md）
# 未配置时钱包 UI 不渲染，应用保持免登录匿名可用
# ============================================================
VITE_PARA_API_KEY=

# ============================================================
# 链上证书（InterviewCertificate soulbound NFT，Monad Testnet chainId 10143）
# 合约部署 + 验证 + 索引器全流程见 docs/monad-onchain.md
# 未配置时铸证 UI 不渲染，报告流程不受影响
# ============================================================
# 部署后的合约地址（0x 前缀 42 字符）
VITE_CERT_ADDRESS=
# Envio HyperIndex 托管 GraphQL 端点（indexer 上 Envio Cloud 后填入；未配置时"我的链上证书"列表隐藏）
VITE_ENVIO_GRAPHQL_URL=
