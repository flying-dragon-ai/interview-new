{
  "name": "群面模拟器",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts-js-resolver.mjs --test \"tests/*.test.ts\"",
    "contracts:compile": "node contracts/scripts/compile.mjs",
    "contracts:test": "cd contracts && pnpm dlx @foundry-rs/forge test -vv",
    "contracts:deploy:testnet": "bash contracts/scripts/deploy-monad-testnet.sh",
    "contracts:verify:testnet": "bash contracts/scripts/verify-monad-testnet.sh",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:secrets && npm run typecheck && npm run test && npm run build && npm run check:bundle",
    "test:e2e": "node scripts/e2e-api.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@getpara/evm-wallet-connectors": "^3.23.0",
    "@getpara/react-sdk": "^3.23.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@tanstack/react-query": "^5.104.3",
    "@types/pg": "^8.18.0",
    "@vercel/node": "^5.6.16",
    "@vercel/postgres": "^0.10.0",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "viem": "^2.57.7",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "solc": "^0.8.37",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vercel": "^50.33.0",
    "vite": "^6.2.0"
  }
}
