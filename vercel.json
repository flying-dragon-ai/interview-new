{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/sessions/:id/:action",
      "destination": "/api/sessions?__sessionRoute=:id/:action"
    },
    {
      "source": "/api/sessions/:id",
      "destination": "/api/sessions?__sessionRoute=:id"
    }
  ]
}
